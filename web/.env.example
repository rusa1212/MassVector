# 공공데이터포털에서 발급받은 일반 인증키(Encoding 또는 Decoding)를 입력하세요.
PUBLIC_DATA_SERVICE_KEY=your_service_key_here

# Supabase 프로젝트의 Project URL과 Service Role Key입니다.
# Service Role Key는 RLS를 우회하므로 서버 코드에서만 사용하고 절대
# NEXT_PUBLIC_ 접두사를 붙이거나 클라이언트에 노출하지 마세요.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# GitHub Actions에도 같은 이름의 Repository Secret으로 등록해야 합니다.
